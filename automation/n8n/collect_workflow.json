{
  "name": "job-trend-mcp 일일 수집",
  "nodes": [
    {
      "id": "f1d49e28-8537-4bcd-a9d4-e651255e3c32",
      "name": "매일 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "f846c29e-b2d4-4516-866d-77291fba5611",
      "name": "GitHub 수집 워크플로 실행",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/DaeunSon/job-trend-mcp/actions/workflows/collect.yml/dispatches",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"ref\": \"main\", \"inputs\": {\"sites\": \"\"}}",
        "options": {}
      }
    },
    {
      "id": "235ac011-41a7-4e29-930a-ad9f94c8f9d6",
      "name": "수집 결과 수신",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        260
      ],
      "webhookId": "dfd75c84-0b51-4c1f-906b-c9b3090db2fa",
      "parameters": {
        "httpMethod": "POST",
        "path": "job-trend-collect",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "e071e13c-f4bf-493e-81d3-17ebb15bc9a3",
      "name": "실패 또는 품질 게이트 실패?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        260,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "45fb5cbc-c0c0-4bfc-b7e4-4e2d92605cdf",
              "leftValue": "={{ $json.body.overall }}",
              "rightValue": "ok",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "6ec2c005-3e70-424a-8454-04f0f1a1a4b8",
              "leftValue": "={{ $json.body.quality_passed }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "id": "2c2bfd80-2520-4b4c-b950-2959d11bf2c2",
      "name": "알림 메일",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        520,
        160
      ],
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "=[job-trend-mcp] 수집 {{ $json.body.overall }} · 품질 게이트 {{ $json.body.quality_passed ? '통과' : '실패' }}",
        "emailType": "text",
        "message": "=수집 결과: {{ $json.body.overall }}\n공고 {{ $json.body.total_postings }}건\n\n사이트별:\n{{ $json.body.sites.map(s => `${s.source}  ${s.status}  +${s.added} (총 ${s.total}, ERROR ${s.error_lines})`).join('\\n') }}\n\n품질 게이트 문제:\n{{ Object.entries($json.body.failed_checks || {}).map(([k, v]) => `${k}: ${v.join('; ')}`).join('\\n') || '없음' }}\n\n네트워크 오류로 다시 돌릴 사이트: {{ ($json.body.retry || []).join(' ') || '없음' }}\n\n실행 로그: {{ $json.body.run_url }}",
        "options": {}
      }
    },
    {
      "id": "f799d27e-ac68-4ddd-b8ed-941328b7ff3e",
      "name": "정상 — 기록만",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        520,
        360
      ],
      "parameters": {}
    }
  ],
